# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# Crunchtime auth is per-customer-instance (plan §8): a customer's CT admin mints
# a dedicated "API User" + API token in Enterprise Manager → Security.

# test | prod  — selects the base URL. Build against test first (plan §1).
CT_ENV=test

# Sitename = the host portion before .net-chef.com, INCLUDING the -test suffix on test.
# e.g. test:  eattacos-test     prod:  eattacos
CT_SITENAME=

# The four auth header values (plan §1):
CT_AUTH_TOKEN=
CT_USER_ID=
CT_PASSWORD=

# ── MenuWorks (Webtrition 3.0 / Compass) ──────────────────────────────────────
MW_ENV=prod
MW_CLIENT_ID=<Webtrition WT-Client-Id from MenuWorks onboarding>
MW_IBM_CLIENT_ID=<IBM gateway X-IBM-Client-Id — DIFFERENT per env (qa vs prod)>

# Postgres on Railway (plan §4). Use the connection string from the Railway dashboard.
# On Railway, reference the Postgres plugin var instead: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Daily change email (SMTP — Gmail/O365) ────────────────────────────────────
# Gmail: turn on 2FA, create a 16-char App Password, use it as SMTP_PASSWORD.
# O365:  SMTP_HOST=smtp.office365.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=you@example.com
SMTP_PASSWORD=
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com          # comma-separated for multiple recipients

